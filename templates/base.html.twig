<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}DWG — Outils numériques & apps métiers{% endblock %}
		</title>
		<meta name="description" content="{% block meta_description %}DWG conçoit CRM, portails clients et apps web/mobile sur-mesure pour accélérer votre activité. Audit offert, maintenance et projets cadrés.{% endblock %}">
		<meta property="og:type" content="website">
		<meta property="og:locale" content="fr_FR">
		<meta property="og:title" content="{% block og_title %}{{ block('title') }}{% endblock %}">
		<meta property="og:description" content="{% block og_description %}{{ block('meta_description') }}{% endblock %}">
		<meta property="og:url" content="{{ app.request.uri }}">
		<meta property="og:image" content="{{ absolute_url(asset('images/hero-workspace.jpg')) }}">
		<meta name="theme-color" content="#0b1c24">

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">
		<link rel="icon" type="image/jpeg" href="{{ asset('images/logo-dwg.jpg') }}">
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
		<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
		<link rel="stylesheet" href="{{ asset('styles/style.css') }}?v=10">
	</head>
	<body class="{% block body_class %}{% endblock %}">
		{% block curtain %}{% endblock %}
		<header class="site-header {% block header_class %}site-header--compact{% endblock %}">
			<nav class="navbar navbar-expand-lg navbar-dark">
				<div class="container">
					<a class="navbar-brand" href="{{ path('app_home') }}">
						<img class="brand-logo-image" src="{{ asset('images/logo-dwg.jpg') }}" alt="DWG — Développement web & applications métier">
					</a>
					<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
						<span class="navbar-toggler-icon"></span>
					</button>
					<div class="collapse navbar-collapse" id="navbarNav">
						<ul class="navbar-nav ms-auto align-items-lg-center">
							<li class="nav-item">
								<a class="nav-link" href="{{ path('app_home') }}#services">Services</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" href="{{ path('app_home') }}#cases">Cas clients</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" href="{{ path('app_home') }}#offre">Offre</a>
							</li>
							<li class="nav-item">
								<a class="nav-link nav-link--cta" href="{{ path('app_home') }}#contact">Contact</a>
							</li>
							{% if is_granted('IS_AUTHENTICATED_FULLY') %}
								{% if is_granted('ROLE_ADMIN') %}
									<li class="nav-item">
										<a class="nav-link nav-link--muted" href="{{ path('admin_dashboard') }}">Admin</a>
									</li>
								{% endif %}
								<li class="nav-item">
									<a class="nav-link nav-link--muted" href="{{ path('app_logout') }}">Déconnexion</a>
								</li>
							{% else %}
								<li class="nav-item">
									<a class="nav-link nav-link--muted" href="{{ path('app_login') }}">Espace client</a>
								</li>
							{% endif %}
						</ul>
					</div>
				</div>
			</nav>
			<div class="theme-toggle-container">
				<button id="theme-toggle" aria-label="Changer le mode">
					<i class="bi bi-sun"></i>
				</button>
			</div>
			{% block hero %}
			<div class="page-hero">
				<div class="container">
					<p class="page-hero__brand">DWG</p>
					{% block page_hero_title %}
						<h1 class="page-hero__title">{{ block('title') }}</h1>
					{% endblock %}
				</div>
			</div>
			{% endblock %}
		</header>

		{% for label, messages in app.flashes %}
			<div class="container flash-wrap">
				{% for message in messages %}
					<div class="alert alert-{{ label }} mt-3 mb-0">{{ message }}</div>
				{% endfor %}
			</div>
		{% endfor %}

		<main class="main-content">
			{% block body %}{% endblock %}
		</main>

		<footer class="site-footer">
			<div class="container footer-content">
				<div class="footer-brand">
					<p class="footer-logo">
						<img class="footer-logo-image" src="{{ asset('images/logo-dwg.jpg') }}" alt="Logo DWG">
					</p>
					<p class="footer-tagline">Studio web orienté résultat & relation humaine.</p>
				</div>
				<div class="social-links">
					<a href="{{ path('app_home') }}#services">Services</a>
					<a href="{{ path('app_home') }}#contact">Contact</a>
					<a href="{{ path('app_mentions_legales') }}">Mentions légales</a>
					<a href="{{ path('app_politique_confidentialite') }}">Confidentialité</a>
					<a href="{{ path('app_cgu') }}">CGU</a>
					<a href="https://www.instagram.com/leliardrene/" target="_blank" rel="noopener">Instagram</a>
				</div>
				<div class="contact-info">
					<p>
						Email :
						<a href="mailto:developpeur.web.gard@gmail.com">developpeur.web.gard@gmail.com</a>
					</p>
				</div>
			</div>
		</footer>

		<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
		<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
		<script src="{{ asset('script/script.js') }}?v=10"></script>
	</body>
</html>
