<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}DWG
			{% endblock %}
		</title>

		{# Styles #}
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">
		<link rel="icon" type="image/jpeg" href="{{ asset('images/474851447_122125318802592487_4148178225004169393_n.jpg') }}">
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
		<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
		<link rel="stylesheet" href="{{ asset('styles/style.css') }}?v=7">
	</head>
	<body>
		<div class="hero-curtain" id="hero-curtain" aria-hidden="true">
			<span class="hero-curtain__panel hero-curtain__panel--left"></span>
			<span class="hero-curtain__panel hero-curtain__panel--right"></span>
			<span class="hero-curtain__slash"></span>
			<span class="hero-curtain__mark">DWG</span>
		</div>
		<header class="site-header">
			<nav class="navbar navbar-expand-lg navbar-dark">
				<div class="container">
					<a class="navbar-brand" href="{{ path('app_home') }}">
						<img class="brand-logo-image" src="{{ asset('images/474851447_122125318802592487_4148178225004169393_n.jpg') }}" alt="Logo DWG">
						<span class="brand-name">DWG</span>
					</a>
					<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
						<span class="navbar-toggler-icon"></span>
					</button>
					<div class="collapse navbar-collapse" id="navbarNav">
						<ul class="navbar-nav ms-auto">
							{% if is_granted('IS_AUTHENTICATED_FULLY') %}
								{% if is_granted('ROLE_ADMIN') %}
									<li class="nav-item">
										<a class="nav-link" href="{{ path('admin_dashboard') }}">
											<i class="bi bi-speedometer2"></i>
											Tableau de bord
										</a>
									</li>
									<li class="nav-item">
										<a class="nav-link" href="{{ path('app_product_index') }}">
											<i class="bi bi-box-seam"></i>
											Gestion des produits
										</a>
									</li>
								{% endif %}
								<li class="nav-item">
									<a class="nav-link" href="{{ path('app_logout') }}">
										<i class="bi bi-box-arrow-right"></i>
										Déconnexion
									</a>
								</li>
							{% else %}
								<li class="nav-item">
									<a class="nav-link" href="{{ path('app_login') }}">
										<i class="bi bi-box-arrow-in-right"></i>
										Connexion
									</a>
								</li>
								<li class="nav-item">
									<a class="nav-link" href="{{ path('app_register') }}">
										<i class="bi bi-person-plus"></i>
										Inscription
									</a>
								</li>
							{% endif %}
						</ul>
					</div>
				</div>
			</nav>
			<div class="theme-toggle-container">
				<button id="theme-toggle" aria-label="Changer le mode">
					<i class="bi bi-moon"></i>
				</button>
			</div>
			{% block hero %}
			<section class="hero" aria-label="Introduction DWG">
				<div class="hero-stage" aria-hidden="true">
					<div class="hero-media">
						<img class="hero-media__image" src="{{ asset('images/hero-workspace.jpg') }}" alt="" width="1920" height="1080" decoding="async" fetchpriority="high">
					</div>
					<canvas id="hero-canvas" class="hero-canvas"></canvas>
					<div class="hero-orb hero-orb--teal"></div>
					<div class="hero-orb hero-orb--amber"></div>
					<div class="hero-stage__grid"></div>
					<div class="hero-stage__wash"></div>
					<div class="hero-stage__scan"></div>
					<div class="hero-spotlight" id="hero-spotlight"></div>
				</div>
				<div class="container hero-content">
					<p class="hero-brand" aria-label="DWG">
						<span class="hero-brand__letter">D</span><span class="hero-brand__letter">W</span><span class="hero-brand__letter">G</span>
					</p>
					<span class="hero-brand-line" aria-hidden="true"></span>
					<h1 class="hero-title">Des outils numériques qui accélèrent vraiment votre métier.</h1>
					<p class="hero-subtitle">CRM, portails et apps sur-mesure — conçus pour être utiles dès le premier jour.</p>
					<div class="hero-actions">
						<a href="#services" class="btn btn-primary btn-lg">Découvrir nos services</a>
						<a href="#contact-quick" class="btn btn-outline-light btn-lg">Parler de votre projet</a>
					</div>
				</div>
			</section>
			{% endblock %}
		</header>
		{% for label, messages in app.flashes %}
			<div class="alert alert-{{ label }}">
				{% for message in messages %}
					{{ message }}
				{% endfor %}
			</div>
		{% endfor %}


		{# Main Content Block #}
		<main class="main-content">
			{% block body %}
				<div class="container">
					{% for type, messages in app.flashes %}
						{% for message in messages %}
							<div class="alert alert-{{ type }} mt-2">
								{{ message }}
							</div>
						{% endfor %}
					{% endfor %}
				{% endblock %}
			</main>
			<footer class="site-footer">
				<div class="container footer-content">
					<div class="footer-brand">
						<p class="footer-logo">
							<img class="footer-logo-image" src="{{ asset('images/474851447_122125318802592487_4148178225004169393_n.jpg') }}" alt="Logo DWG">
							DWG
						</p>
						<p class="footer-tagline">Studio web orienté résultat & relation humaine.</p>
					</div>
					<div class="social-links">
						<a href="{{ path('app_mentions_legales') }}">Mentions légales</a>
						<a href="{{ path('app_politique_confidentialite') }}">Politique de confidentialité</a>
						<a href="{{ path('app_cgu') }}">CGU</a>
						<a href="https://www.facebook.com/profile.php?id=61567774622871" target="_blank" rel="noopener">Facebook</a>
						<a href="https://www.facebook.com/profile.php?id=61567774622871" target="_blank" rel="noopener">Facebook Pro</a>
						<a href="https://www.instagram.com/leliardrene/" target="_blank" rel="noopener">Instagram</a>
					</div>
					<div class="contact-info">
						<p>
							Email :
							<a href="mailto:developpeur.web.gard@gmail.com">developpeur.web.gard@gmail.com</a>
						</p>
					</div>
				</div>
			</footer>
		</div>
		{# Scripts #}
		<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
		<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
		<script src="{{ asset('script/script.js') }}?v=7"></script>
	</body>
</html>
