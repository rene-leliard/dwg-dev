{% extends 'base.html.twig' %}

{% block title %}DWG — Outils métiers pour artisans & TPE (Gard){% endblock %}
{% block body_class %}page-home{% endblock %}
{% block header_class %}{% endblock %}
{# Affichés dans la section contact pour être visibles après #contact #}
{% block flashes %}{% endblock %}

{% block curtain %}
	<div class="hero-curtain" id="hero-curtain" aria-hidden="true">
		<span class="hero-curtain__panel hero-curtain__panel--left"></span>
		<span class="hero-curtain__panel hero-curtain__panel--right"></span>
		<span class="hero-curtain__slash"></span>
		<span class="hero-curtain__mark">DWG</span>
	</div>
{% endblock %}

{% block hero %}
	<section class="hero" aria-label="Introduction DWG">
		<div class="hero-stage" aria-hidden="true">
			<div class="hero-media">
				<img class="hero-media__image" src="{{ asset('images/hero-workspace.jpg') }}" alt="Poste de travail développeur avec écrans d’outils métiers" width="1920" height="1080" decoding="async" fetchpriority="high">
			</div>
			<canvas id="hero-canvas" class="hero-canvas"></canvas>
			<div class="hero-orb hero-orb--teal"></div>
			<div class="hero-orb hero-orb--amber"></div>
			<div class="hero-stage__grid"></div>
			<div class="hero-stage__wash"></div>
			<div class="hero-stage__scan"></div>
			<div class="hero-spotlight" id="hero-spotlight"></div>
		</div>
		<div class="container hero-content">
			<p class="hero-brand" aria-label="DWG">
				<span class="hero-brand__letter">D</span><span class="hero-brand__letter">W</span><span class="hero-brand__letter">G</span>
			</p>
			<span class="hero-brand-line" aria-hidden="true"></span>
			<h1 class="hero-title">Moins de paperasse. Plus de temps sur le terrain.</h1>
			<p class="hero-subtitle">Demandes, rendez-vous, devis, factures et paiements — des outils simples, pensés pour votre quotidien.</p>
			<div class="hero-actions">
				<a href="#services" class="btn btn-primary btn-lg">Voir les services</a>
				<a href="#contact" class="btn btn-outline-light btn-lg">Discutons de votre besoin</a>
			</div>
		</div>
	</section>
{% endblock %}

{% block body %}
	<section id="presentation" class="section">
		<div class="container">
			<div class="section-split">
				<div class="section-heading section-heading--flush">
					<p class="eyebrow">À propos</p>
					<h2>René, développeur à Saint-Victor-la-Coste</h2>
					<p class="section-lead">
						Je conçois et maintiens des outils numériques pour artisans et TPE du Gard — sans jargon inutile, avec un seul interlocuteur du premier échange à la mise en service.
					</p>
				</div>
				<div class="stats-grid">
					<div class="stat-card">
						<span>+5 ans</span>
						<p>Sur des projets web et apps métiers, du devis à la production.</p>
					</div>
					<div class="stat-card">
						<span>1 contact</span>
						<p>Vous parlez directement à moi — pas à un call center.</p>
					</div>
					<div class="stat-card">
						<span>Échange offert</span>
						<p>30–45&nbsp;min pour clarifier le besoin et une fourchette budgétaire.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section id="process" class="section section-muted">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">Méthode</p>
				<h2>Une méthode simple, étape par étape</h2>
				<p class="section-lead">Vous savez toujours où on en est — et ce qui est livré.</p>
			</div>
			<ol class="process-grid">
				<li class="process-step">
					<span class="process-step__num">01</span>
					<h3>Échange</h3>
					<p>On parle de votre quotidien : demandes clients, planning, devis, factures… et ce qui vous fait perdre du temps.</p>
				</li>
				<li class="process-step">
					<span class="process-step__num">02</span>
					<h3>Cadrage</h3>
					<p>Périmètre, priorités, estimation et planning réaliste — validés avant de coder.</p>
				</li>
				<li class="process-step">
					<span class="process-step__num">03</span>
					<h3>Réalisation</h3>
					<p>Petites étapes, démos régulières, mise en service maîtrisée.</p>
				</li>
				<li class="process-step">
					<span class="process-step__num">04</span>
					<h3>Suivi</h3>
					<p>Maintenance, évolutions et support pour que l’outil reste utile dans la durée.</p>
				</li>
			</ol>
		</div>
	</section>

	<section id="services" class="section">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">Services</p>
				<h2>Ce que ça change concrètement pour vous</h2>
				<p class="section-lead">Moins de double saisie, moins d’oublis, un suivi plus clair — chaque mission est cadrée et livrable.</p>
			</div>
			<div class="services-grid">
				<article class="service-card">
					<div class="service-card__icon"><i class="bi bi-gear"></i></div>
					<h3>Suivi clients &amp; automatisations</h3>
					<p class="service-meta">Demandes, devis, relances</p>
					<p>Centralisez contacts, rendez-vous et relances ; synchronisez ce qui doit l’être pour éviter les oublis.</p>
					<button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#serviceModalCms">En savoir plus</button>
				</article>
				<article class="service-card featured">
					<p class="service-card__badge">Le plus demandé</p>
					<div class="service-card__icon"><i class="bi bi-shield-check"></i></div>
					<h3>Maintenance web &amp; mobile</h3>
					<p class="service-meta">Stabilité &amp; sécurité</p>
					<p>On surveille, on corrige, on fait évoluer vos sites et apps — pour qu’ils restent fiables au quotidien.</p>
					<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#serviceModalVitrine">En savoir plus</button>
				</article>
				<article class="service-card">
					<div class="service-card__icon"><i class="bi bi-lightning-charge"></i></div>
					<h3>Apps sur-mesure</h3>
					<p class="service-meta">Web &amp; mobile</p>
					<p>Espace client, planning, saisie terrain : un outil taillé pour votre façon de travailler.</p>
					<button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#serviceModalEcommerce">En savoir plus</button>
				</article>
			</div>
		</div>
	</section>

	<section id="cases" class="section section-muted">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">Cas client</p>
				<h2>Ce qui change concrètement</h2>
				<p class="section-lead">Une mission réelle avec <strong>Godin-eau</strong> — spécialiste de la relève et du renouvellement de compteurs d’eau.</p>
			</div>

			<article class="case-feature">
				<div class="case-feature__main">
					<p class="case-feature__tag">Godin-eau — Occitanie / réseaux d’eau</p>
					<h3>Structurer l’ordonnancement et le suivi terrain</h3>
					<p>
						Godin-eau intervient auprès de mairies, régies et syndicats pour la relève / le renouvellement de compteurs et le géoréférencement des réseaux.
						L’enjeu : fiabiliser la planification des interventions et offrir un suivi plus clair aux abonnés — sans empiler les tableurs et les allers-retours.
					</p>
					<div class="case-feature__cols">
						<div>
							<h4>Ce qui a été livré</h4>
							<ul class="case-list">
								<li>Outil d’ordonnancement adapté au flux terrain</li>
								<li>Suivi des interventions et des statuts</li>
								<li>Vue opérationnelle pour les équipes</li>
								<li>Accompagnement à la prise en main</li>
							</ul>
						</div>
						<div>
							<h4>Résultat observé</h4>
							<ul class="case-list">
								<li>Planification plus lisible au quotidien</li>
								<li>Moins de friction entre bureau et terrain</li>
								<li>Meilleure traçabilité des interventions</li>
								<li>Base solide pour faire évoluer le pôle ordonnancement</li>
							</ul>
						</div>
					</div>
				</div>
				<aside class="case-feature__aside">
					<p class="case-feature__aside-label">Le client</p>
					<div class="case-metric"><strong>Godin-eau</strong><span>Relève &amp; renouvellement de compteurs</span></div>
					<div class="case-metric"><strong>National</strong><span>Interventions réseaux d’eau</span></div>
					<div class="case-metric"><strong>Métier</strong><span>Ordonnancement &amp; suivi abonnés</span></div>
					<a href="https://www.godin-eau.com/" class="btn btn-outline-primary" target="_blank" rel="noopener">Voir leur site</a>
					<a href="#contact" class="btn btn-primary">Un projet similaire ?</a>
				</aside>
			</article>

			<div class="case-stack case-stack--compact">
				<article class="case-row">
					<span class="case-row__index">02</span>
					<div class="case-row__body">
						<h3>App mobile terrain</h3>
						<p>Saisie sur téléphone, photos, synchronisation et validation au bureau pour les équipes en déplacement.</p>
					</div>
				</article>
				<article class="case-row">
					<span class="case-row__index">03</span>
					<div class="case-row__body">
						<h3>Espace client</h3>
						<p>Documents, demandes et historique au même endroit — moins d’allers-retours par email.</p>
					</div>
				</article>
			</div>
		</div>
	</section>

	<section id="offre" class="section">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">Offre</p>
				<h2>Des portes d’entrée claires</h2>
				<p class="section-lead">Pas de devis opaque : vous savez ce que couvre chaque formule.</p>
			</div>
			<div class="offer-grid">
				<article class="offer-card">
					<p class="offer-card__price">Offert</p>
					<h3>Premier échange</h3>
					<p>30–45&nbsp;min pour regarder vos outils, ce qui bloque, et les prochaines actions utiles.</p>
					<ul class="case-list">
						<li>Priorités clarifiées</li>
						<li>Pistes concrètes</li>
						<li>Fourchette budgétaire réaliste</li>
					</ul>
					<a href="#contact" class="btn btn-outline-primary">Discutons de votre besoin</a>
				</article>
				<article class="offer-card offer-card--featured">
					<p class="offer-card__price">Forfait mensuel</p>
					<h3>Maintenance</h3>
					<p>Gardez vos sites et apps stables, sécurisés et évolutifs — avec un interlocuteur dédié.</p>
					<ul class="case-list">
						<li>Surveillance &amp; correctifs</li>
						<li>Mises à jour maîtrisées</li>
						<li>Petit quota d’évolutions</li>
					</ul>
					<a href="#contact" class="btn btn-primary">Demander un forfait</a>
				</article>
				<article class="offer-card">
					<p class="offer-card__price">Sur devis</p>
					<h3>Projet sur-mesure</h3>
					<p>Suivi clients, espace client ou app terrain : un livrable cadré, avec étapes et validation.</p>
					<ul class="case-list">
						<li>Cadrage écrit</li>
						<li>Démos régulières</li>
						<li>Mise en service &amp; prise en main</li>
					</ul>
					<a href="#contact" class="btn btn-outline-primary">Lancer un projet</a>
				</article>
			</div>
		</div>
	</section>

	<section id="contact" class="section section-cta">
		<div class="container">
			<div class="cta-band cta-band--form">
				<div class="cta-band__copy">
					<p class="eyebrow">Contact</p>
					<h2>Discutons de votre besoin</h2>
					<p class="section-lead">
						Réponse sous 24–48&nbsp;h ouvrées. Décrivez simplement ce qui vous ralentit au quotidien — on verra ensemble la suite.
					</p>
					<p class="contact-form__legend">Les champs marqués d’un <span class="contact-form__req" aria-hidden="true">*</span><span class="visually-hidden">astérisque</span> sont obligatoires.</p>

					{% set contactFlashes = app.flashes %}
					{% if contactFlashes %}
						<div class="contact-flash" id="contact-flash" tabindex="-1">
							{% for label, messages in contactFlashes %}
								{% for message in messages %}
									<div class="alert alert-{{ label }} flash-alert contact-flash__alert" role="status">
										{% if label == 'success' %}
											<i class="bi bi-check-circle-fill" aria-hidden="true"></i>
										{% elseif label == 'warning' %}
											<i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
										{% else %}
											<i class="bi bi-info-circle-fill" aria-hidden="true"></i>
										{% endif %}
										<span>{{ message }}</span>
									</div>
								{% endfor %}
							{% endfor %}
						</div>
					{% endif %}

					{{ form_start(contactForm, { attr: { class: 'contact-form', novalidate: 'novalidate', 'data-contact-form': '1' } }) }}
						{{ form_errors(contactForm) }}
						<div class="contact-form__grid">
							<div class="contact-form__field">
								{{ form_label(contactForm.name) }}
								{{ form_widget(contactForm.name, { attr: { class: 'form-control' } }) }}
								{{ form_help(contactForm.name) }}
								{{ form_errors(contactForm.name) }}
							</div>
							<div class="contact-form__field">
								{{ form_label(contactForm.email) }}
								{{ form_widget(contactForm.email, { attr: { class: 'form-control' } }) }}
								{{ form_help(contactForm.email) }}
								{{ form_errors(contactForm.email) }}
							</div>
							<div class="contact-form__field contact-form__field--full">
								{{ form_label(contactForm.company) }}
								{{ form_widget(contactForm.company, { attr: { class: 'form-control' } }) }}
								{{ form_help(contactForm.company) }}
								{{ form_errors(contactForm.company) }}
							</div>
							<div class="contact-form__field">
								{{ form_label(contactForm.need) }}
								{{ form_widget(contactForm.need, { attr: { class: 'form-select' } }) }}
								{{ form_help(contactForm.need) }}
								{{ form_errors(contactForm.need) }}
							</div>
							<div class="contact-form__field">
								{{ form_label(contactForm.budget) }}
								{{ form_widget(contactForm.budget, { attr: { class: 'form-select' } }) }}
								{{ form_help(contactForm.budget) }}
								{{ form_errors(contactForm.budget) }}
							</div>
							<div class="contact-form__field contact-form__field--full">
								{{ form_label(contactForm.message) }}
								{{ form_widget(contactForm.message, { attr: { class: 'form-control' } }) }}
								<div class="contact-form__meta">
									{{ form_help(contactForm.message) }}
									<p class="contact-form__counter" data-char-counter="contact-message" aria-live="polite">
										<span data-char-count>0</span> / 4000 — minimum 20
									</p>
								</div>
								{{ form_errors(contactForm.message) }}
							</div>
						</div>
						{{ form_row(contactForm.website) }}
						{{ form_rest(contactForm) }}
						<button type="submit" class="btn btn-primary btn-lg">Envoyer ma demande</button>
					{{ form_end(contactForm) }}
				</div>
				<aside class="cta-band__aside">
					<p class="cta-band__aside-label">Ce que vous obtenez</p>
					<ul class="case-list">
						<li>Retour personnalisé sous 48&nbsp;h</li>
						<li>Lecture franche du besoin</li>
						<li>Prochaine étape claire (échange ou devis)</li>
					</ul>
					<div class="cta-band__direct">
						<p class="cta-band__aside-label">Me joindre directement</p>
						{% if contact_phone %}
							<p class="cta-band__note">
								<a class="cta-band__phone" href="tel:{{ contact_phone }}">
									<i class="bi bi-telephone-fill" aria-hidden="true"></i>
									{{ contact_phone_display ?: contact_phone }}
								</a>
							</p>
						{% endif %}
						<p class="cta-band__note">
							<a href="mailto:{{ contact_email }}">{{ contact_email }}</a>
						</p>
						<p class="cta-band__note cta-band__note--muted">René Leliard — Saint-Victor-la-Coste (Gard)</p>
					</div>
				</aside>
			</div>
		</div>
	</section>

	<div class="modal fade" id="serviceModalCms" tabindex="-1" aria-labelledby="serviceModalCmsLabel" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="serviceModalCmsLabel">Suivi clients &amp; automatisations</h5>
					<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
				</div>
				<div class="modal-body">
					<p class="mb-3">Gardez le fil de vos clients sans tout saisir trois fois.</p>
					<ul>
						<li>Centraliser demandes, devis et relances.</li>
						<li>Automatiser les tâches répétitives (rappels, statuts).</li>
						<li>Tableaux de bord et exports utiles au quotidien.</li>
						<li>Nettoyer et fiabiliser vos données clients.</li>
						<li>Prise en main et documentation claire.</li>
					</ul>
				</div>
				<div class="modal-footer">
					<a href="#contact" class="btn btn-primary" data-bs-dismiss="modal">Discutons de votre besoin</a>
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
				</div>
			</div>
		</div>
	</div>
	<div class="modal fade" id="serviceModalVitrine" tabindex="-1" aria-labelledby="serviceModalVitrineLabel" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="serviceModalVitrineLabel">Maintenance web &amp; mobile</h5>
					<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
				</div>
				<div class="modal-body">
					<p class="mb-3">Gardez vos sites et apps stables, sécurisés et performants.</p>
					<ul>
						<li>Surveillance et alertes proactives.</li>
						<li>Correctifs rapides et mises à jour maîtrisées.</li>
						<li>Optimisation des temps de réponse.</li>
						<li>Sauvegardes et plan de reprise.</li>
						<li>Roadmap d’évolutions priorisées.</li>
					</ul>
				</div>
				<div class="modal-footer">
					<a href="#contact" class="btn btn-primary" data-bs-dismiss="modal">Demander un forfait</a>
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
				</div>
			</div>
		</div>
	</div>
	<div class="modal fade" id="serviceModalEcommerce" tabindex="-1" aria-labelledby="serviceModalEcommerceLabel" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="serviceModalEcommerceLabel">Apps sur-mesure</h5>
					<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
				</div>
				<div class="modal-body">
					<p class="mb-3">Une application web ou mobile alignée sur votre façon de travailler.</p>
					<ul>
						<li>Apps métiers web et mobile.</li>
						<li>Espace client et outils de gestion interne.</li>
						<li>Synchronisation entre vos outils existants.</li>
						<li>Droits d’accès selon les rôles.</li>
						<li>Améliorations d’usage ciblées.</li>
					</ul>
				</div>
				<div class="modal-footer">
					<a href="#contact" class="btn btn-primary" data-bs-dismiss="modal">Lancer un projet</a>
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
