{% extends 'base.html.twig' %}

{% block body %}
	<section id="presentation" class="section">
		<div class="container">
			<div class="section-split">
				<div class="section-heading section-heading--flush">
					<p class="eyebrow">À propos de DWG</p>
					<h2>Des outils pro pour structurer et accélérer votre activité</h2>
					<p class="section-lead">
						Nous concevons des solutions digitales orientées performance métier : CRM, automatisations, portails clients et applications web/mobile.
					</p>
				</div>
				<div class="stats-grid">
					<div class="stat-card">
						<span>+5 ans</span>
						<p>Expérience en création web et accompagnement clients.</p>
					</div>
					<div class="stat-card">
						<span>100%</span>
						<p>De projets livrés avec suivi et maintenance.</p>
					</div>
					<div class="stat-card">
						<span>Sur-mesure</span>
						<p>Chaque solution est adaptée à votre activité.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section id="services" class="section section-muted">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">Services</p>
				<h2>Des solutions métiers, claires et mesurables</h2>
				<p class="section-lead">Objectifs, livrables et résultats : chaque mission est cadrée et pilotée.</p>
			</div>
			<div class="services-grid">
				<article class="service-card">
					<div class="service-card__icon">
						<i class="bi bi-gear"></i>
					</div>
					<h3>Outils &amp; automatisations CRM</h3>
					<p class="service-meta">Intégrations sur vos outils existants</p>
					<p>Workflows, synchronisations et automatisations pour des process fiables.</p>
					<button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#serviceModalCms">En savoir plus</button>
				</article>
				<article class="service-card featured">
					<p class="service-card__badge">Le plus demandé</p>
					<div class="service-card__icon">
						<i class="bi bi-shield-check"></i>
					</div>
					<h3>Maintenance web &amp; mobile</h3>
					<p class="service-meta">Stabilité, sécurité, performance</p>
					<p>Supervision, correctifs et évolutions continues de vos outils.</p>
					<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#serviceModalVitrine">En savoir plus</button>
				</article>
				<article class="service-card">
					<div class="service-card__icon">
						<i class="bi bi-lightning-charge"></i>
					</div>
					<h3>Apps web &amp; mobile sur-mesure</h3>
					<p class="service-meta">Sur devis</p>
					<p>Applications métiers, portails clients et back-offices sur mesure.</p>
					<button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#serviceModalEcommerce">En savoir plus</button>
				</article>
			</div>
		</div>
	</section>

	<section id="cases" class="section">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">Cas d’usage</p>
				<h2>Des scénarios concrets, orientés outils</h2>
				<p class="section-lead">Exemples fréquents pour clarifier ce qui est livré.</p>
			</div>
			<div class="case-stack">
				<article class="case-row">
					<span class="case-row__index">01</span>
					<div class="case-row__body">
						<h3>CRM + automatisations</h3>
						<p>Centralisation des leads, scoring, relances et reporting.</p>
						<ul class="case-list">
							<li>Gain de temps sur les tâches répétitives</li>
							<li>Suivi commercial plus fiable</li>
							<li>Moins d’oubli dans les relances</li>
						</ul>
					</div>
				</article>
				<article class="case-row">
					<span class="case-row__index">02</span>
					<div class="case-row__body">
						<h3>App mobile terrain</h3>
						<p>Saisie terrain, synchronisation et validation centralisée.</p>
						<ul class="case-list">
							<li>Formulaires mobiles et photos</li>
							<li>Synchronisation temps réel</li>
							<li>Alertes et statuts automatisés</li>
						</ul>
					</div>
				</article>
				<article class="case-row">
					<span class="case-row__index">03</span>
					<div class="case-row__body">
						<h3>Portail client web</h3>
						<p>Espace sécurisé pour documents, demandes et suivi.</p>
						<ul class="case-list">
							<li>Accès client et rôles</li>
							<li>Historique des demandes</li>
							<li>Notifications automatiques</li>
						</ul>
					</div>
				</article>
			</div>
		</div>
	</section>

	<section id="contact-quick" class="section section-cta">
		<div class="container">
			<div class="cta-band">
				<div class="cta-band__copy">
					<p class="eyebrow">Discutons</p>
					<h2>Un besoin CRM, web ou mobile&nbsp;?</h2>
					<p class="section-lead">
						Audit rapide, plan d’action clair et estimation réaliste. Réponse sous 24–48&nbsp;h ouvrées.
					</p>
					<div class="hero-actions">
						<a href="mailto:developpeur.web.gard@gmail.com" class="btn btn-primary btn-lg">Écrire un email</a>
						<a href="#services" class="btn btn-outline-light btn-lg">Voir nos services</a>
					</div>
				</div>
				<div class="cta-band__aside">
					<p class="cta-band__aside-label">Inclus dans le premier échange</p>
					<ul class="case-list">
						<li>Points de friction identifiés</li>
						<li>Recommandations opérationnelles</li>
						<li>Estimation réaliste</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<div class="modal fade" id="serviceModalCms" tabindex="-1" aria-labelledby="serviceModalCmsLabel" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="serviceModalCmsLabel">Outils &amp; automatisations CRM</h5>
					<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<p class="mb-3">Optimisez vos outils existants avec des automatisations fiables.</p>
					<ul>
						<li>Connecteurs entre CRM, marketing et support.</li>
						<li>Automatisation des tâches répétitives.</li>
						<li>Tableaux de bord et exports dédiés.</li>
						<li>Nettoyage et fiabilisation des données.</li>
						<li>Documentation et transfert d’exploitation.</li>
					</ul>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
				</div>
			</div>
		</div>
	</div>
	<div class="modal fade" id="serviceModalVitrine" tabindex="-1" aria-labelledby="serviceModalVitrineLabel" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="serviceModalVitrineLabel">Maintenance web &amp; mobile</h5>
					<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<p class="mb-3">Gardez vos sites et apps stables, sécurisés et performants.</p>
					<ul>
						<li>Surveillance et alertes proactives.</li>
						<li>Correctifs rapides et mises à jour maîtrisées.</li>
						<li>Optimisation des temps de réponse.</li>
						<li>Sauvegardes et plan de reprise.</li>
						<li>Roadmap d’évolutions priorisées.</li>
					</ul>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
				</div>
			</div>
		</div>
	</div>
	<div class="modal fade" id="serviceModalEcommerce" tabindex="-1" aria-labelledby="serviceModalEcommerceLabel" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="serviceModalEcommerceLabel">Apps web &amp; mobile sur-mesure</h5>
					<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<p class="mb-3">Développez des applications web et mobile alignées sur vos besoins.</p>
					<ul>
						<li>Apps métiers web et mobile (iOS/Android).</li>
						<li>Portails clients et back-offices.</li>
						<li>API internes et synchronisations.</li>
						<li>Rôles, permissions et audit.</li>
						<li>Améliorations UX ciblées.</li>
					</ul>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
