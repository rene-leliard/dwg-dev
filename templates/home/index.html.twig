{% extends 'base.html.twig' %}

{% block title %}DWG — Outils métiers pour artisans & TPE{% endblock %}
{% block body_class %}page-home{% endblock %}
{% block header_class %}{% endblock %}
{# Affichés dans la section contact pour être visibles après #contact #}
{% block flashes %}{% endblock %}

{% block curtain %}
	<div class="hero-curtain" id="hero-curtain" aria-hidden="true">
		<span class="hero-curtain__panel hero-curtain__panel--left"></span>
		<span class="hero-curtain__panel hero-curtain__panel--right"></span>
		<span class="hero-curtain__slash"></span>
		<span class="hero-curtain__mark">DWG</span>
	</div>
{% endblock %}

{% block head_extra %}
	<link rel="preload" as="image" href="{{ asset('images/hero-workspace.webp') }}" type="image/webp" fetchpriority="high">
{% endblock %}

{% block hero %}
	<section class="hero" aria-label="Introduction DWG">
		<div class="hero-stage" aria-hidden="true">
			<div class="hero-media">
				<picture>
					<source srcset="{{ asset('images/hero-workspace.webp') }}" type="image/webp">
					<img class="hero-media__image" src="{{ asset('images/hero-workspace.jpg') }}" alt="Poste de travail développeur avec écrans d’outils métiers" width="1280" height="720" decoding="async" fetchpriority="high">
				</picture>
			</div>
			<canvas id="hero-canvas" class="hero-canvas"></canvas>
			<div class="hero-orb hero-orb--teal"></div>
			<div class="hero-orb hero-orb--amber"></div>
			<div class="hero-stage__grid"></div>
			<div class="hero-stage__wash"></div>
			<div class="hero-stage__scan"></div>
			<div class="hero-spotlight" id="hero-spotlight"></div>
		</div>
		<div class="container hero-content">
			<p class="hero-brand" aria-label="DWG">
				<span class="hero-brand__letter">D</span><span class="hero-brand__letter">W</span><span class="hero-brand__letter">G</span>
			</p>
			<span class="hero-brand-line" aria-hidden="true"></span>
			<h1 class="hero-title">Moins de paperasse. Plus de temps sur le terrain.</h1>
			<p class="hero-subtitle">Demandes, rendez-vous, devis, factures et paiements — des outils simples, pensés pour votre quotidien.</p>
			<div class="hero-actions">
				<a href="#services" class="btn btn-primary btn-lg">Voir les services</a>
				<a href="#contact" class="btn btn-outline-light btn-lg">Discutons de votre besoin</a>
			</div>
		</div>
	</section>
{% endblock %}

{% block body %}
	<section id="presentation" class="section">
		<div class="container">
			<div class="section-split">
				<div class="section-heading section-heading--flush">
					<p class="eyebrow">À propos</p>
					<h2>René, développeur à Saint-Victor-la-Coste</h2>
					<p class="section-lead">
						Je conçois et maintiens des outils numériques pour artisans et TPE — basé dans le Gard, j’accompagne aussi les entreprises à distance partout en France. Sans jargon inutile, avec un seul interlocuteur du premier échange à la mise en service.
					</p>
				</div>
				<div class="stats-grid">
					<div class="stat-card">
						<span>+5 ans</span>
						<p>Sur des projets web et apps métiers, du devis à la production.</p>
					</div>
					<div class="stat-card">
						<span>1 contact</span>
						<p>Vous parlez directement à moi — pas à un call center.</p>
					</div>
					<div class="stat-card">
						<span>Échange offert</span>
						<p>30–45&nbsp;min pour clarifier le besoin et une fourchette budgétaire.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section id="process" class="section section-muted">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">Méthode</p>
				<h2>Une méthode simple, étape par étape</h2>
				<p class="section-lead">Vous savez toujours où on en est — et ce qui est livré.</p>
			</div>
			<ol class="process-grid">
				<li class="process-step">
					<span class="process-step__num">01</span>
					<h3>Échange</h3>
					<p>On parle de votre quotidien : demandes clients, planning, devis, factures… et ce qui vous fait perdre du temps.</p>
				</li>
				<li class="process-step">
					<span class="process-step__num">02</span>
					<h3>Cadrage</h3>
					<p>Périmètre, priorités, estimation et planning réaliste — validés avant de coder.</p>
				</li>
				<li class="process-step">
					<span class="process-step__num">03</span>
					<h3>Réalisation</h3>
					<p>Petites étapes, démos régulières, mise en service maîtrisée.</p>
				</li>
				<li class="process-step">
					<span class="process-step__num">04</span>
					<h3>Suivi</h3>
					<p>Maintenance, évolutions et support pour que l’outil reste utile dans la durée.</p>
				</li>
			</ol>
		</div>
	</section>

	<section id="services" class="section">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">Services</p>
				<h2>Ce que ça change concrètement pour vous</h2>
				<p class="section-lead">Moins de double saisie, moins d’oublis, un suivi plus clair — chaque mission est cadrée et livrable.</p>
			</div>
			<div class="services-grid">
				<article class="service-card">
					<div class="service-card__icon"><i class="bi bi-gear"></i></div>
					<h3>Suivi clients &amp; automatisations</h3>
					<p class="service-meta">Demandes, devis, relances</p>
					<p>Centralisez contacts, rendez-vous et relances ; synchronisez ce qui doit l’être pour éviter les oublis.</p>
					<button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#serviceModalCms">En savoir plus</button>
				</article>
				<article class="service-card featured">
					<p class="service-card__badge">Le plus demandé</p>
					<div class="service-card__icon"><i class="bi bi-shield-check"></i></div>
					<h3>Maintenance web &amp; mobile</h3>
					<p class="service-meta">Stabilité &amp; sécurité</p>
					<p>On surveille, on corrige, on fait évoluer vos sites et apps — pour qu’ils restent fiables au quotidien.</p>
					<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#serviceModalVitrine">En savoir plus</button>
				</article>
				<article class="service-card">
					<div class="service-card__icon"><i class="bi bi-lightning-charge"></i></div>
					<h3>Apps sur-mesure</h3>
					<p class="service-meta">Web &amp; mobile</p>
					<p>Espace client, planning, saisie terrain : un outil taillé pour votre façon de travailler.</p>
					<button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#serviceModalEcommerce">En savoir plus</button>
				</article>
			</div>
		</div>
	</section>

	<section id="cases" class="section section-muted">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">Cas client</p>
				<h2>Ce qui change concrètement</h2>
				<p class="section-lead">Une mission réelle avec <strong>Godin-eau</strong> — spécialiste de la relève et du renouvellement de compteurs d’eau.</p>
			</div>

			<article class="case-feature">
				<div class="case-feature__main">
					<p class="case-feature__tag">Godin-eau — Occitanie / réseaux d’eau</p>
					<h3>Organiser le planning et le suivi des interventions</h3>
					<p>
						Godin-eau intervient auprès de mairies, régies et syndicats pour la relève / le renouvellement de compteurs et le géoréférencement des réseaux.
						L’enjeu : fiabiliser la planification des interventions et offrir un suivi plus clair aux abonnés — sans empiler les tableurs et les allers-retours.
					</p>
					<div id="godinCarousel" class="carousel slide case-carousel" data-bs-ride="false" data-bs-interval="false" aria-label="Aperçus de l’outil Godin-eau (données anonymisées)">
						<div class="carousel-indicators">
							<button type="button" data-bs-target="#godinCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Planning"></button>
							<button type="button" data-bs-target="#godinCarousel" data-bs-slide-to="1" aria-label="Affectations"></button>
							<button type="button" data-bs-target="#godinCarousel" data-bs-slide-to="2" aria-label="Suivi chantier"></button>
						</div>
						<div class="carousel-inner">
							<div class="carousel-item active">
								<button
									type="button"
									class="case-carousel__zoom"
									data-lightbox-src="{{ asset('images/godin-eau-planning.jpg') }}"
									data-lightbox-alt="Planning mensuel des techniciens — clients et noms anonymisés"
									data-lightbox-caption="Planning terrain — noms et chantiers anonymisés"
								>
									<img
										src="{{ asset('images/godin-eau-planning.jpg') }}"
										alt="Planning mensuel des techniciens — clients et noms anonymisés"
										width="1600"
										height="900"
										loading="lazy"
										decoding="async"
									>
									<span class="case-carousel__hint" aria-hidden="true"><i class="bi bi-zoom-in"></i></span>
									<span class="visually-hidden">Agrandir l’image</span>
								</button>
								<p class="case-carousel__caption">Planning terrain — noms et chantiers anonymisés</p>
							</div>
							<div class="carousel-item">
								<button
									type="button"
									class="case-carousel__zoom"
									data-lightbox-src="{{ asset('images/godin-eau-affectation.jpg') }}"
									data-lightbox-alt="Administration des affectations agents / secteurs — données anonymisées"
									data-lightbox-caption="Affectations agents / lots — données anonymisées"
								>
									<img
										src="{{ asset('images/godin-eau-affectation.jpg') }}"
										alt="Administration des affectations agents / secteurs — données anonymisées"
										width="1600"
										height="900"
										loading="lazy"
										decoding="async"
									>
									<span class="case-carousel__hint" aria-hidden="true"><i class="bi bi-zoom-in"></i></span>
									<span class="visually-hidden">Agrandir l’image</span>
								</button>
								<p class="case-carousel__caption">Affectations agents / lots — données anonymisées</p>
							</div>
							<div class="carousel-item">
								<button
									type="button"
									class="case-carousel__zoom case-carousel__zoom--portrait"
									data-lightbox-src="{{ asset('images/godin-eau-suivi.jpg') }}"
									data-lightbox-alt="Suivi de chantier — montants fictifs à titre d’illustration, non contractuels"
									data-lightbox-caption="Suivi chantier — montants fictifs (illustration uniquement), sans lien avec les chiffres réels de Godin-eau"
								>
									<img
										src="{{ asset('images/godin-eau-suivi.jpg') }}"
										alt="Suivi de chantier — montants fictifs à titre d’illustration, non contractuels"
										width="900"
										height="1200"
										loading="lazy"
										decoding="async"
									>
									<span class="case-carousel__hint" aria-hidden="true"><i class="bi bi-zoom-in"></i></span>
									<span class="visually-hidden">Agrandir l’image</span>
								</button>
								<p class="case-carousel__caption">Suivi chantier — <strong>montants fictifs</strong> (illustration uniquement), sans lien avec les chiffres réels de Godin-eau</p>
							</div>
						</div>
						<button class="carousel-control-prev" type="button" data-bs-target="#godinCarousel" data-bs-slide="prev">
							<span class="carousel-control-prev-icon" aria-hidden="true"></span>
							<span class="visually-hidden">Précédent</span>
						</button>
						<button class="carousel-control-next" type="button" data-bs-target="#godinCarousel" data-bs-slide="next">
							<span class="carousel-control-next-icon" aria-hidden="true"></span>
							<span class="visually-hidden">Suivant</span>
						</button>
					</div>
					<div class="case-feature__cols">
						<div>
							<h4>Ce qui a été livré</h4>
							<ul class="case-list">
								<li>Outil de planning adapté aux interventions sur le terrain</li>
								<li>Suivi des interventions et des statuts</li>
								<li>Vue opérationnelle pour les équipes</li>
								<li>Accompagnement à la prise en main</li>
							</ul>
						</div>
						<div>
							<h4>Résultat observé</h4>
							<ul class="case-list">
								<li>Planification plus lisible au quotidien</li>
								<li>Moins de friction entre bureau et terrain</li>
								<li>Meilleure traçabilité des interventions</li>
								<li>Base solide pour faire évoluer le pôle planning</li>
							</ul>
						</div>
					</div>
				</div>
				<aside class="case-feature__aside">
					<p class="case-feature__aside-label">Le client</p>
					<div class="case-metric"><strong>Godin-eau</strong><span>Relève &amp; renouvellement de compteurs</span></div>
					<div class="case-metric"><strong>National</strong><span>Interventions réseaux d’eau</span></div>
					<div class="case-metric"><strong>Métier</strong><span>Planning &amp; suivi abonnés</span></div>
					<a href="https://www.godin-eau.com/" class="btn btn-outline-primary" target="_blank" rel="noopener">Voir leur site</a>
					<a href="#contact" class="btn btn-primary">Un projet similaire ?</a>
				</aside>
			</article>

			<div class="case-stack case-stack--compact">
				<article class="case-row">
					<span class="case-row__index">02</span>
					<div class="case-row__body">
						<h3>App mobile terrain</h3>
						<p>Saisie sur téléphone, photos, synchronisation et validation au bureau pour les équipes en déplacement.</p>
					</div>
				</article>
				<article class="case-row">
					<span class="case-row__index">03</span>
					<div class="case-row__body">
						<h3>Espace client</h3>
						<p>Documents, demandes et historique au même endroit — moins d’allers-retours par email.</p>
					</div>
				</article>
			</div>
		</div>
	</section>

	<section id="offre" class="section">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">Offre</p>
				<h2>Des portes d’entrée claires</h2>
				<p class="section-lead">Pas de devis opaque : vous savez ce que couvre chaque formule.</p>
			</div>
			<div class="offer-grid">
				<article class="offer-card">
					<p class="offer-card__price">Offert</p>
					<h3>Premier échange</h3>
					<p>30–45&nbsp;min pour regarder vos outils, ce qui bloque, et les prochaines actions utiles.</p>
					<ul class="case-list">
						<li>Priorités clarifiées</li>
						<li>Pistes concrètes</li>
						<li>Fourchette budgétaire réaliste</li>
					</ul>
					<a href="#contact" class="btn btn-outline-primary">Discutons de votre besoin</a>
				</article>
				<article class="offer-card offer-card--featured">
					<p class="offer-card__price">Forfait mensuel</p>
					<h3>Maintenance</h3>
					<p>Gardez vos sites et apps stables, sécurisés et évolutifs — avec un interlocuteur dédié.</p>
					<ul class="case-list">
						<li>Surveillance &amp; correctifs</li>
						<li>Mises à jour maîtrisées</li>
						<li>Évolutions : volume et conditions définis dans le forfait proposé</li>
					</ul>
					<a href="#contact" class="btn btn-primary">Demander un forfait</a>
				</article>
				<article class="offer-card">
					<p class="offer-card__price">Sur devis</p>
					<h3>Projet sur-mesure</h3>
					<p>Suivi clients, espace client ou app terrain : un livrable cadré, avec étapes et validation.</p>
					<ul class="case-list">
						<li>Cadrage écrit</li>
						<li>Démos régulières</li>
						<li>Mise en service &amp; prise en main</li>
					</ul>
					<a href="#contact" class="btn btn-outline-primary">Lancer un projet</a>
				</article>
			</div>
		</div>
	</section>

	{% set contactFlashes = app.flashes %}
	{% set contactFlashLabels = contactFlashes|keys %}
	{% set contactStatus = contactFormHasErrors|default(false) ? 'error' : ( 'success' in contactFlashLabels ? 'success' : ( 'warning' in contactFlashLabels ? 'warning' : '' ) ) %}
	<section
		id="contact"
		class="section section-cta"
		data-contact-status="{{ contactStatus }}"
		{% if contactStatus %}data-contact-feedback="1"{% endif %}
	>
		<div class="container">
			<div class="cta-band cta-band--form">
				<div class="cta-band__copy">
					<p class="eyebrow">Contact</p>
					<h2>Discutons de votre besoin</h2>
					<p class="section-lead">
						Réponse sous 24–48&nbsp;h ouvrées. Décrivez simplement ce qui vous ralentit au quotidien — on verra ensemble la suite.
					</p>
					<p class="contact-form__legend">Nom, email et message suffisent pour un premier échange. Les champs marqués d’un <span class="contact-form__req" aria-hidden="true">*</span><span class="visually-hidden">astérisque</span> sont obligatoires.</p>

					{% if contactFlashes %}
						<div class="contact-flash" id="contact-flash" tabindex="-1" data-contact-flash="{{ contactStatus ?: 'info' }}">
							{% for label, messages in contactFlashes %}
								{% for message in messages %}
									<div class="alert alert-{{ label }} flash-alert contact-flash__alert" role="status">
										{% if label == 'success' %}
											<i class="bi bi-check-circle-fill" aria-hidden="true"></i>
										{% elseif label == 'warning' %}
											<i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
										{% else %}
											<i class="bi bi-info-circle-fill" aria-hidden="true"></i>
										{% endif %}
										<span>{{ message }}</span>
									</div>
								{% endfor %}
							{% endfor %}
						</div>
					{% elseif contactFormHasErrors|default(false) %}
						<div class="contact-flash" id="contact-flash" tabindex="-1" data-contact-flash="error">
							<div class="alert alert-danger flash-alert contact-flash__alert" role="alert">
								<i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
								<div class="contact-flash__body">
									<strong>Votre demande n’a pas pu être envoyée.</strong>
									<p class="contact-flash__hint">Corrigez les points ci-dessous, puis renvoyez le formulaire.</p>
									<ul class="contact-flash__errors">
										{% for error in contactForm.vars.errors %}
											<li>{{ error.message }}</li>
										{% endfor %}
										{% for child in contactForm.children %}
											{% if child.vars.name != 'website' %}
												{% for error in child.vars.errors %}
													<li>
														<a href="#{{ child.vars.id }}">{{ child.vars.label }} — {{ error.message }}</a>
													</li>
												{% endfor %}
											{% endif %}
										{% endfor %}
									</ul>
								</div>
							</div>
						</div>
					{% endif %}

					{% if contactStatus != 'success' %}
					{{ form_start(contactForm, {
						action: path('app_home') ~ '#contact',
						attr: {
							class: 'contact-form',
							novalidate: 'novalidate',
							'data-contact-form': '1',
							'aria-describedby': contactFormHasErrors|default(false) ? 'contact-flash' : false
						}
					}) }}
						{% if contactForm.vars.errors|length and not contactFormHasErrors|default(false) %}
							{{ form_errors(contactForm) }}
						{% endif %}
						<div class="contact-form__grid">
							<div class="contact-form__field{% if not contactForm.name.vars.valid %} contact-form__field--invalid{% endif %}">
								{{ form_label(contactForm.name) }}
								{{ form_widget(contactForm.name, { attr: { class: 'form-control' ~ (contactForm.name.vars.valid ? '' : ' is-invalid'), 'aria-invalid': contactForm.name.vars.valid ? 'false' : 'true' } }) }}
								{{ form_help(contactForm.name) }}
								{{ form_errors(contactForm.name) }}
							</div>
							<div class="contact-form__field{% if not contactForm.email.vars.valid %} contact-form__field--invalid{% endif %}">
								{{ form_label(contactForm.email) }}
								{{ form_widget(contactForm.email, { attr: { class: 'form-control' ~ (contactForm.email.vars.valid ? '' : ' is-invalid'), 'aria-invalid': contactForm.email.vars.valid ? 'false' : 'true' } }) }}
								{{ form_help(contactForm.email) }}
								{{ form_errors(contactForm.email) }}
							</div>
							<div class="contact-form__field contact-form__field--full{% if not contactForm.company.vars.valid %} contact-form__field--invalid{% endif %}">
								{{ form_label(contactForm.company) }}
								{{ form_widget(contactForm.company, { attr: { class: 'form-control' ~ (contactForm.company.vars.valid ? '' : ' is-invalid'), 'aria-invalid': contactForm.company.vars.valid ? 'false' : 'true' } }) }}
								{{ form_help(contactForm.company) }}
								{{ form_errors(contactForm.company) }}
							</div>
							<div class="contact-form__field{% if not contactForm.need.vars.valid %} contact-form__field--invalid{% endif %}">
								{{ form_label(contactForm.need) }}
								{{ form_widget(contactForm.need, { attr: { class: 'form-select' ~ (contactForm.need.vars.valid ? '' : ' is-invalid'), 'aria-invalid': contactForm.need.vars.valid ? 'false' : 'true' } }) }}
								{{ form_help(contactForm.need) }}
								{{ form_errors(contactForm.need) }}
							</div>
							<div class="contact-form__field{% if not contactForm.budget.vars.valid %} contact-form__field--invalid{% endif %}">
								{{ form_label(contactForm.budget) }}
								{{ form_widget(contactForm.budget, { attr: { class: 'form-select' ~ (contactForm.budget.vars.valid ? '' : ' is-invalid'), 'aria-invalid': contactForm.budget.vars.valid ? 'false' : 'true' } }) }}
								{{ form_help(contactForm.budget) }}
								{{ form_errors(contactForm.budget) }}
							</div>
							<div class="contact-form__field contact-form__field--full{% if not contactForm.message.vars.valid %} contact-form__field--invalid{% endif %}">
								{{ form_label(contactForm.message) }}
								{{ form_widget(contactForm.message, { attr: { class: 'form-control' ~ (contactForm.message.vars.valid ? '' : ' is-invalid'), 'aria-invalid': contactForm.message.vars.valid ? 'false' : 'true' } }) }}
								<div class="contact-form__meta">
									{{ form_help(contactForm.message) }}
									<p class="contact-form__counter" data-char-counter="contact-message" aria-live="polite">
										<span data-char-count>0</span> / 4000
									</p>
								</div>
								{{ form_errors(contactForm.message) }}
							</div>
						</div>
						{{ form_row(contactForm.website) }}
						{{ form_rest(contactForm) }}
						<button type="submit" class="btn btn-primary btn-lg">Envoyer ma demande</button>
					{{ form_end(contactForm) }}
					{% else %}
						<p class="contact-form__after-success">Vous pouvez aussi me joindre directement à droite si besoin.</p>
					{% endif %}
				</div>
				<aside class="cta-band__aside">
					<p class="cta-band__aside-label">Ce que vous obtenez</p>
					<ul class="case-list">
